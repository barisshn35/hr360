# HR360 ortam degiskenleri - referans.
#
# Bu dosyayi elle doldurmaniza gerek yok: ./install.sh sorar/uretir ve .env dosyasini yazar.
# Burada docker-compose.yml ve scripts/ altindaki betiklerin okudugu TUM degiskenler, birer satirlik
# aciklamayla listelenir. Bos birakilan sirlar install.sh tarafindan uretilir. .env'i asla commit etmeyin.
# Sirlar .env yerine secrets/*.txt dosyalarinda da tutulabilir: scripts/secrets-migrate.sh

# ---------------------------------------------------------------- Erisim
# Gateway'in disariya actigi HTTP portu (HTTPS ayri: GATEWAY_TLS_PORT).
GATEWAY_PORT=80
# Uygulamanin adresi (sema + alan adi, port yok).
PUBLIC_URL=http://localhost
# Tarayicida kullanilan tam koken (sema + alan adi [+ port]); Keycloak adresi ve jeton ureticisi (issuer) buradan.
PUBLIC_ORIGIN=http://localhost

# ---------------------------------------------------------------- Urun ayarlari
# Demo verisi: "demo" sirketi ve demo.admin (install.sh --demo -> true). Tanimsizsa (eski kurulum) acik kabul edilir.
HR360_DEMO=false
# Herkese acik sirket kaydi (giris ekranindaki "Sirketinizi kaydedin", /kayit); install.sh --no-signup -> false.
PUBLIC_SIGNUP_ENABLED=true
# Sirket kipi (install.sh --tenancy): single = tek sirket (sirket kurulumda olusur; sirket listesi ve kayit gizli),
# multi = cok sirket (varsayilan). Gecis: Platform > Bakim > Sirket kipi ya da scripts/tenancy.sh.
HR360_TENANCY=multi
HR360_COMPANY_NAME=
# Isteğe bagli moduller (install.sh --edition/--modules; sonradan Platform > Bakim > Moduller ya da
# scripts/modules.sh). Kapali modul icin HR360_MOD_<MODUL>=0 yazilir; satir yoksa modul aciktir:
# RECRUITMENT, ONBOARDING, TIMESHIFT, PERFORMANCE, LEARNING, COMPENSATION, ML, EXPENSE.
# HR360_MODULES etkin listeyi servislere ve arayuze bildirir; scripts/modules.sh yazar, elle duzenlemeyin.
HR360_MODULES=all
# HR360_MOD_ML=0
# Platform yoneticisi hesaplarinda iki adimli dogrulama zorunlu olsun mu (uretimde onerilir: true).
MFA_REQUIRE_PLATFORM_ADMIN=false
# Not: HR360_VERSION .env'e yazilmaz; install.sh/scripts/update.sh web derlemesine depo kokundeki VERSION'dan verir.
# Keycloak giris akisina passkey (WebAuthn) ikinci adimini ekler.
KEYCLOAK_PASSKEYS=true
# Google Workspace / Microsoft 365 hesap acma/kapatma (IK onayindan sonra); bkz. docs/entegrasyonlar/dogrulama.md
ACCOUNT_PROVISIONING_ENABLED=false

# ---------------------------------------------------------------- Veritabani (PostgreSQL)
# hr360admin parolasi (tum servislerin varsayilan baglantisi).
HR360_DB_PASSWORD=
# Servis basina en az yetkili roller (scripts/db-roles.sh enable yazar). Desen, her servis icin:
#   HR360_DB_USER_<SERVIS>=hr360_<servis>      HR360_DB_PASSWORD_<SERVIS>=...
# <SERVIS>: ORGANIZATION EMPLOYEE WORKFLOW LEAVE RECRUITMENT ONBOARDING TIMESHIFT PERFORMANCE LEARNING
#           ENGAGEMENT GOVERNANCE COMPENSATION EXPENSE NOTIFICATION TENANT, ayrica RETENTION (saklama isi).
# Tanimsizsa servis hr360admin ve HR360_DB_PASSWORD ile baglanir.

# ---------------------------------------------------------------- Keycloak
# Master yonetici (Keycloak yonetim paneli).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# tenant-service'in Keycloak yonetim API servis hesabi (hr360-tenant-admin) anahtari; scripts/keycloak-service-account.sh.
KEYCLOAK_TENANT_ADMIN_CLIENT_SECRET=
# Eski kurulumlar icin gecis yolu (master parola); bos = tenant-service'e master parola verilmez.
KEYCLOAK_TENANT_ADMIN_LEGACY_USER=
KEYCLOAK_TENANT_ADMIN_LEGACY_PASSWORD=
# Platform yoneticisi (platform.admin): tum kiracilar, kiraci olusturma, plan, askiya alma.
PLATFORM_ADMIN_PASSWORD=
# demo.admin parolasi (yalnizca HR360_DEMO=true; demo sirketinin yoneticisi).
DEMO_ADMIN_PASSWORD=
# ml-inference servisinin Keycloak istemci anahtari.
ML_KEYCLOAK_CLIENT_SECRET=

# Keycloak yonetim paneli erisimi - scripts/keycloak-admin-access.sh yonetir.
# open (varsayilan) | ip | port (firewall ile kisitlamak icin)
KEYCLOAK_ADMIN_MODE=open
# ip/port modunda nginx'te izinli IP/CIDR'ler (virgulle).
KEYCLOAK_ADMIN_ALLOWED_IPS=
# Yonetim portunun dinledigi adres (port modunda 0.0.0.0).
KEYCLOAK_ADMIN_BIND=127.0.0.1
# Yonetim paneli portu (dis guvenlik duvarinda yalnizca yonetim IP'lerine acin).
KEYCLOAK_ADMIN_PORT=8090
# Gateway konteynerindeki hedef port: 8090 (HTTP) ya da ana adres HTTPS ise 8443 (ayni sertifika).
KEYCLOAK_ADMIN_CONTAINER_PORT=8090
# Port modunda yonetim konsolunun adresi (orn. https://hr.sirket.com:8090/auth).
KEYCLOAK_ADMIN_URL=

# ---------------------------------------------------------------- Sifreleme ve ic anahtarlar
# Hassas alanlari (enc1:, AES-256-GCM) sifreleyen anahtar: base64 kodlu tam 32 byte (openssl rand -base64 32).
TENANT_SECRET_KEY=
# Anahtar yenileme: "kimlik:base64,kimlik:base64" (ilk = etkin); bos = yalnizca TENANT_SECRET_KEY. scripts/crypto-keys.sh
TENANT_SECRET_KEYS=
# Eski anahtarla sifreli degerleri arka planda yeniden yaz: auto | off.
CRYPTO_REENCRYPT=auto
# Servisler arasi ic cagri anahtari (X-Internal-Token); scripts/rotate-internal-token.sh yeniler.
INTERNAL_SERVICE_TOKEN=
# Yenileme sirasinda bir onceki anahtar (kesintisiz gecis icin gecici olarak kabul edilir).
INTERNAL_SERVICE_TOKEN_PREVIOUS=
# Redis (Valkey) onbellek parolasi (yalnizca ic agda).
REDIS_PASSWORD=
# MinIO (S3 uyumlu nesne deposu) root kimligi.
MINIO_ROOT_USER=hr360minio
MINIO_ROOT_PASSWORD=
# Denetim kaydinin SIEM'e aktarimi: udp://sunucu:514 ya da tcp://sunucu:601 (bos = kapali).
SIEM_SYSLOG_ENDPOINT=
# SIEM'e giden kullanici takma adlarinin anahtari (bos = kurulumdan turetilir).
SIEM_PSEUDONYM_KEY=

# ---------------------------------------------------------------- E-posta (SMTP)
# install.sh sorar; ayni ayar Keycloak realm'ine de yazilir. Sonradan: scripts/smtp.sh set --from ...
# SMTP_HOST=mailpit = paketteki test kutusu, GERCEK GONDERIM YAPMAZ (uretimde gercek sunucu girin).
SMTP_HOST='mailpit'
SMTP_PORT=1025
SMTP_USER='hr360'
SMTP_PASSWORD='hr360'
SMTP_FROM_ADDRESS='noreply@hr360.local'
SMTP_FROM_NAME='HR360'
# Sunucunun kendi posta servisi (install.sh --mail-mode=self / scripts/smtp.sh self; varsayilan kapali):
# SMTP_HOST='mailer', SMTP_PORT=25, kullanici/parola bos ve COMPOSE_PROFILES'ta "mailer".
# MAIL_HOSTNAME: sunucunun tam adi (IP'nin PTR kaydi bunu gostermeli); MAIL_DOMAIN: gonderen alan adi.
MAIL_MODE=
MAIL_HOSTNAME=
MAIL_DOMAIN=
DKIM_SELECTOR=hr360
# Yonetici e-postasi (sertifika bildirimleri, sistem uyarilari).
HR360_ADMIN_EMAIL=

# ---------------------------------------------------------------- HTTPS (scripts/tls.sh yonetir)
# HTTPS portunun dinledigi adres (HTTPS acikken 0.0.0.0).
GATEWAY_TLS_BIND=127.0.0.1
GATEWAY_TLS_PORT=443
# bos | letsencrypt | certificate | self-signed | external
TLS_MODE=
# Let's Encrypt bekleyen alan adi ve e-postasi (DNS hazir olunca saatlik yeniden deneme).
TLS_LE_PENDING=
TLS_LE_EMAIL=
# Etkin profiller (virgulle): letsencrypt (tls.sh), monitoring (monitoring.sh), mailer (smtp.sh self).
COMPOSE_PROFILES=

# ---------------------------------------------------------------- Yedekleme (scripts/backup.sh)
# Arsiv sifreleme anahtari (AES-256); kaybolursa sifreli yedekler acilamaz, ayri bir yerde saklayin.
BACKUP_ENCRYPTION_KEY=
# Yedek ozetinin (manifest) HMAC imza anahtari; bos = BACKUP_ENCRYPTION_KEY'den turetilir.
BACKUP_MANIFEST_KEY=
# Dis depo (S3 uyumlu: MinIO, Ceph, yerli bulut); yalnizca sifreli arsiv gonderilir.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Kova icindeki on ek (klasor).
BACKUP_S3_PREFIX=
# Yurt disi saglayiciya (AWS, Azure, GCP...) gonderim icin KVKK m.9 dayanagi varsa 1.
BACKUP_S3_ABROAD_OK=
# --to-minio: nesne kilitli (WORM) MinIO kovasi; bos URL = kurulumun kendi MinIO'su.
BACKUP_MINIO_URL=
BACKUP_MINIO_BUCKET=hr360-backups-locked
BACKUP_MINIO_PREFIX=
# Kimlik bos ise MINIO_ROOT_USER/PASSWORD kullanilir.
BACKUP_MINIO_ACCESS_KEY=
BACKUP_MINIO_SECRET_KEY=
# Saklama kipi GOVERNANCE | COMPLIANCE ve suresi (gun).
BACKUP_MINIO_RETENTION_MODE=GOVERNANCE
BACKUP_MINIO_RETENTION_DAYS=30
# mc'nin baglanacagi Docker agi (bos: kendi MinIO icin hr360-net, dis URL icin host).
BACKUP_MINIO_NETWORK=
# mc imaji (bos = sabitlenmis bitnamilegacy/minio-client).
BACKUP_MC_IMAGE=

# ---------------------------------------------------------------- Izleme (scripts/monitoring.sh yonetir)
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# Prometheus metrik saklama suresi ve disk tavani (dolarsa en eski veri silinir).
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB
# Loki log saklama suresi (168h = 7 gun) ve alim hizi siniri (MB/sn).
LOKI_RETENTION=168h
LOKI_INGESTION_RATE_MB=4
# Tempo dagitik iz saklama suresi (scripts/monitoring.sh tracing on).
TEMPO_RETENTION=72h
# Alarm kanallari - scripts/monitoring.sh alerts ... (e-posta SMTP_* ayarlariyla gider).
ALERT_EMAIL_TO=
ALERT_SLACK_WEBHOOK_URL=
# Teams kanali > Workflows > "Post to a channel when a webhook request is received".
ALERT_TEAMS_WEBHOOK_URL=
ALERT_TIMEZONE=Europe/Istanbul
ALERTMANAGER_PORT=9093

# ---------------------------------------------------------------- Yapay zeka (istege bagli)
# anthropic | openai | ollama; bos = AI araclari kural tabanli. Kiraci yoneticisi acmadikca veri gonderilmez.
#   anthropic: LLM_MODEL orn. claude-sonnet-4-5, LLM_API_KEY gerekli
#   openai:    LLM_MODEL orn. gpt-4o-mini; LLM_BASE_URL ile OpenAI uyumlu baska bir uc
#   ollama:    yerel model (veri sunucudan cikmaz), LLM_BASE_URL=http://ollama:11434/v1
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# OpenAI uyumlu ama kendi sunucunuzdaki model icin true (arayuzde "yerel" gosterilir).
LLM_LOCAL=false
# Kiraci basina saatlik istek siniri ve kota penceresi (dakika).
LLM_HOURLY_LIMIT=200
LLM_QUOTA_WINDOW_MINUTES=60

# ---------------------------------------------------------------- Yalnizca test ortami
# OpenLDAP test sunucusunun yonetici parolasi (--profile ldaptest, deploy/testing/chat-mock.yml).
LDAP_TEST_ADMIN_PASSWORD=
# Not: scripts/test.sh integration|e2e|all yalnizca kabukta HR360_TEST_ENV=1 ile calisir (.env'e yazmayin).

     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hr360_chat_command_duration_seconds_bucket{provider=~\"$provider\"}[5m])))",
     "legendFormat": "p95",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(hr360_chat_command_duration_seconds_bucket{provider=~\"$provider\"}[5m])))",
     "legendFormat": "p99",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }

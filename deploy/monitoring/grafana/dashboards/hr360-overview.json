   "options": {},
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "service": "Servis",
       "endpoint": "Uç",
       "Value": "p95"
      }
     }
    }

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Arayüz denetimi (npm run lint:js; CI "web" işi). ESLint yerine Oxlint: typescript-eslint
  // TypeScript 7'yi (yerel derleyici) desteklemiyor; Oxlint TypeScript'e bağlı değil, aynı kuralları uygular.
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",

    // React Compiler hazırlık kuralları: derleyici kullanılmıyor. Sunucu verisini forma kopyalayan
    // useEffect, ölçüm için render'da ref okuma gibi kalıplar bilinçli; derleyiciye geçilirse açılır.
    "react/purity": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/preserve-manual-memoization": "off",

    // role="status" / "radio" / "img" / "group" div üzerinde geçerli ARIA; yerel öğeye (output, input)
    // çevirmek görünümü ve davranışı değiştirir. Erişilebilirlik axe ile de denetlenir (e2e).
    "jsx-a11y/prefer-tag-over-role": "off",
    // Pencere açılınca ilk alana odak WAI-ARIA dialog kalıbıdır.
    "jsx-a11y/no-autofocus": "off",

    // Biçim tercihi.
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "public/**"]
}

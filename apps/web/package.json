{
  "name": "hr360-web",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "lint:js": "oxlint --deny-warnings src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='src/**/*.test.{ts,tsx}' --coverage.exclude='src/**/*.d.ts' --coverage.exclude='src/test/**' --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.thresholds.lines=18 --coverage.thresholds.statements=17 --coverage.thresholds.branches=12 --coverage.thresholds.functions=10",
    "i18n:check": "node scripts/i18n-check.mjs",
    "contrast:check": "node scripts/contrast-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@tanstack/react-query": "^5.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.3",
    "keycloak-js": "^26.2.5",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "6.2.5",
    "react-router-dom": "^7.18.6",
    "read-excel-file": "^9.3.20",
    "recharts": "^3.11.0",
    "swagger-ui-react": "^5.35.1",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "^4.14.1",
    "jsdom": "^30.1.3",
    "oxlint": "1.94.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "remarkable": {
      "argparse": "^2.0.1"
    }
  }
}
